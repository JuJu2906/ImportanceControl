  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "My name is John\n\r\nHi! Nice to meet you! My name is John Smith. I am
    19 and a student in college. I go to college in New York. My favorite courses
    are Geometry, French, and History. English is my hardest course. My professors
    are very friendly and smart. It\u2019s my second year in college now. I love
    it!\r\n\r\nI live in a small house on Ivy Street. It\u2019s near the college
    campus. I share the house with another student. His name is Handu. We help each
    other with homework. On the weekend, we play badminton together.\r\n\r\nI have
    an older brother. He also goes to college. He is 22 and lives with my parents.
    They live on Mulberry Street in Boston. Sometimes they visit me in New York.
    I am happy when they visit. My Mom always brings me candy when they come. I really
    miss them, too!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
